# ====================================================================
# YouTube to Instagram Automation Configuration
# Fill in your YouTube channel, Instagram credentials, and Telegram bot below
# ====================================================================

# --------------------------------------------------------------------
# 1. YouTube Channel Configuration (ZERO LOGIN REQUIRED)
# --------------------------------------------------------------------
# The bot only fetches this ONE public channel. No YouTube or Google login needed!
# Example: https://www.youtube.com/@YourChannel/shorts or https://www.youtube.com/@YourChannel
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@YourChannel/shorts

# Filter exclusively for YouTube Shorts (< 90 seconds)
SHORTS_ONLY=true

# --------------------------------------------------------------------
# 2. Instagram Credentials & Cloud Authentication (for Render)
# --------------------------------------------------------------------
# Your Instagram login credentials
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Local cached session file
INSTAGRAM_SESSION_FILE=instagram_session.json

# RENDER DEPLOYMENT TIP:
# To deploy to Render without getting blocked by Instagram, run locally:
#   python main.py export-session
# Then paste the output string into your Render Environment Variable:
# INSTAGRAM_SESSION_BASE64=eyJzZXNzaW9uIjoiLi4uIn0=

# --------------------------------------------------------------------
# 3. Telegram Bot Notifications & Previous Reel Stats
# --------------------------------------------------------------------
# 1. Open Telegram, search @BotFather, and type /newbot to get your Token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Search @userinfobot on Telegram, send /start to get your Chat ID (e.g. 123456789)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --------------------------------------------------------------------
# 4. Posting Settings & Account Safety
# --------------------------------------------------------------------
# Max videos to upload per batch run (keeps your account safe from rate-limits)
MAX_VIDEOS_PER_RUN=2

# Delay between posts in seconds (recommended 60-180 seconds)
DELAY_BETWEEN_POSTS_SECONDS=90

# Posting order: "oldest_first" (post backlog chronologically) or "newest_first"
POST_ORDER=oldest_first

# Show the Reel on your main Instagram profile feed grid as well
SHARE_TO_FEED=true

# --------------------------------------------------------------------
# 5. Caption Formatting
# --------------------------------------------------------------------
# Max characters for Instagram caption (Instagram limit is 2200)
MAX_CAPTION_LENGTH=2200

# Optional extra hashtags to append to every reel (space-separated)
CUSTOM_HASHTAGS=#reels #shorts

# Automatically strip YouTube-specific phrases like "Subscribe to my channel"
CLEAN_YOUTUBE_LINKS=true

# --------------------------------------------------------------------
# 6. Cloud Deployment & Automation Settings (Render)
# --------------------------------------------------------------------
# Interval in minutes for watch mode & Render background scheduler
CHECK_INTERVAL_MINUTES=60

# Port for Render Web Service (Render automatically sets $PORT)
PORT=10000

# Safety for fresh cloud instances:
# If true, on fresh startup with an empty DB, all existing channel videos are marked baseline
# and only new future uploads will be posted to Instagram.
INITIAL_SYNC_ONLY_NEW=false

# Optional custom database path (e.g. for Render persistent disk: /var/data/posted_videos.db)
# DATABASE_PATH=data/posted_videos.db

# Optional comma-separated list of known YouTube video IDs to seed as already posted
# POSTED_IDS_LIST=vid1,vid2,vid3
